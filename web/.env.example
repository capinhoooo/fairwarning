# Fair Warning web. Copy to .env; never commit .env.

# Backend (bun run dev in ../backend)
VITE_API_URL="http://localhost:3700"

# mainnet | testnet. Testnet uses v1.signer-prod.testnet, which reads Base Sepolia.
VITE_NEAR_NETWORK="testnet"
VITE_FW_CONTRACT_ID="fw.fairwarning.testnet"

# USDC on NEAR used for bonds. Mainnet default: native USDC 17208628f8...6133a1
# VITE_USDC_CONTRACT_ID=""

# Shared Announcer contract on Base (contracts/base/src/Announcer.sol), prefilled in the bond form
# VITE_ANNOUNCER_ADDRESS=""

# VITE_GITHUB_URL="https://github.com/capinhoooo/fairwarning"
